body {
    background-color: #1a1a2e;
    font-family: Arial, sans-serif;
    color: #e0e0e0;
    margin: 0;
    padding: 0;
}
 
 
header {
    background-color: #ff4655;
    color: white;
    text-align: center;
    padding: 30px;
}
 
header h1 {
    font-size: 2.5em;
    margin: 0 0 8px 0;
    letter-spacing: 4px;
}
 
header p {
    font-size: 1em;
    margin: 0;
    color: #ffe0e2;
}
 

 main {
    max-width: 800px;
    margin: 30px auto;
    padding: 0 20px;
}
 
 
section {
    background-color: #16213e;
    border: 1px solid #0f3460;
    border-radius: 8px;
    padding: 20px 25px;
    margin-bottom: 25px;
}
 
section h2 {
    color: #ff4655;
    border-bottom: 2px solid #0f3460;
    padding-bottom: 8px;
    margin-top: 0;
}
 
 
section ul, section ol {
    line-height: 2;
    padding-left: 20px;
}
 

 .dica {
    background-color: #0f3460;
    border-left: 5px solid #ff4655;
}
 
 
footer {
    background-color: #ff4655;
    color: white;
    text-align: center;
    padding: 15px;
    font-size: 0.9em;
}
